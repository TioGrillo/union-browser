{
  "name": "union-browser",
  "version": "1.0.7",
  "description": "Navegador desktop multi-sessão com workspaces",
  "main": "dist/main/bootstrap.js",
  "author": {
    "name": "IdleBrowser"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && electron ./scripts/build-bytecode.js",
    "build:renderer": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "bytenode": "^1.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "react-colorful": "^5.8.0"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/extract-zip": "^2.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "framer-motion": "^12.0.0",
    "i18next": "^25.0.0",
    "javascript-obfuscator": "^5.5.0",
    "lucide-react": "^0.500.0",
    "postcss": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.idlebrowser.app",
    "productName": "UNION BROWSER",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "unionscripts",
        "repo": "union-browser"
      }
    ],
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
